# PostgreSQL connection string for local development.
DATABASE_URL=postgresql://marketplace_user:your_password@localhost:5432/marketplace_db

# Optional path to the legacy SQLite database when migrating existing data.
# SQLITE_MIGRATION_PATH=./backend/database/marketplace.db

UPLOADS_DIR=./frontend/public/uploads
REFUND_EVIDENCE_DIR=./backend/private/refund-evidence
BACKUP_DIR=./backend/database/backups

# Public HTTPS URL of the deployed app. Render can provide this automatically.
# APP_BASE_URL=https://your-marketplace.onrender.com

# Required to bootstrap the first administrator (password must be at least 12 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required for secure production sessions (at least 32 characters).
SESSION_SECRET=

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# SMTP account used to deliver email-verification and password-reset links/codes.
# In development without SMTP, the verification link is printed to the local server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# M-Pesa Daraja STK Push. Use Daraja sandbox credentials for testing.
# The callback must be reachable by Safaricom over public HTTPS; localhost is not reachable.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-public-domain.com/api/payments/mpesa/callback
# The app appends this private token to MPESA_CALLBACK_URL; generate it with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_TOKEN=
