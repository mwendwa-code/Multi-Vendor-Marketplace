# SQLite database locations (relative to the project root).
DB_PATH=./backend/database/marketplace.db
SESSION_DB_PATH=./backend/database/sessions.sqlite

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# SMTP account used to deliver email-verification and password-reset links/codes.
# In development without SMTP, the verification link is printed to the local server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required for administrator authenticator-app MFA. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# M-Pesa Daraja STK Push. Use Daraja sandbox credentials for testing.
# The callback must be reachable by Safaricom over public HTTPS; localhost is not reachable.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-public-domain.com/api/payments/mpesa/callback
# The app appends this private token to MPESA_CALLBACK_URL; generate it with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_TOKEN=
