<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Save recovery codes | The Marketplace</title>
    <style>
        body { margin: 0; min-height: 100vh; padding: 24px; display: grid; place-items: center; font: 16px Arial, sans-serif; color: #172033; background: #f1f5f9; }
        main { width: min(100%, 480px); padding: 28px; background: white; border-radius: 12px; box-shadow: 0 12px 36px #0f172a1a; }
        h1 { color: #102a43; }
        .warning { padding: 12px; color: #854d0e; background: #fefce8; border-radius: 6px; }
        ul { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 16px; background: #f8fafc; border-radius: 6px; list-style: none; }
        code { font-size: 16px; font-weight: 700; }
        a { display: inline-block; margin-top: 14px; padding: 12px 16px; border-radius: 6px; color: white; background: #2563eb; text-decoration: none; }
        :focus-visible { outline: 3px solid #f59e0b; outline-offset: 2px; }
    </style>
</head>
<body>
    <main>
        <h1>Save your recovery codes</h1>
        <p class="warning" role="alert">These codes are shown once. Store them somewhere safe. Each code can be used one time if you cannot access your authenticator.</p>
        <ul>
            <% recoveryCodes.forEach((code) => { %><li><code><%= code %></code></li><% }) %>
        </ul>
        <a href="/admin">Continue to admin dashboard</a>
    </main>
</body>
</html>
