
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | The Marketplace</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            padding: 30px 16px;
            font-family: Arial, sans-serif;
            display: grid;
            place-items: center;
            background-color: #0f172a;
            background-image:
                linear-gradient(115deg, rgba(15, 23, 42, 0.78), rgba(15, 23, 42, 0.34)),
                url("/images/product-home.jpg");
            background-position: center;
            background-size: cover;
            background-attachment: fixed;
        }
        .container {
            max-width: 420px;
            width: 100%;
            margin: 0 auto;
            padding: 28px;
            background: rgba(255, 255, 255, 0.96);
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.32);
            backdrop-filter: blur(8px);
        }
        .brand-link {
            display: flex;
            justify-content: center;
            margin: 0 auto 12px;
        }
        .brand-logo {
            display: block;
            width: 180px;
            max-width: 70%;
            height: auto;
        }
        @media (max-width: 480px) {
            body { padding: 18px 12px; }
            .container { padding: 22px 18px; }
        }
        h1 { text-align: center; color: #172554; }
        label { display: block; margin-top: 18px; }
        input {
            width: 100%;
            padding: 12px;
            margin-top: 7px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
        }
        .password-field {
            display: flex;
            gap: 8px;
            align-items: stretch;
        }
        .password-field input { flex: 1; min-width: 0; }
        .password-toggle {
            width: auto;
            margin-top: 7px;
            padding: 0 11px;
            border: 1px solid #cbd5e1;
            background: white;
            color: #172033;
            display: inline-grid;
            place-items: center;
        }
        .password-toggle svg { width: 20px; height: 20px; }
        .password-toggle .eye-closed { display: none; }
        .password-toggle[aria-pressed="true"] .eye-open { display: none; }
        .password-toggle[aria-pressed="true"] .eye-closed { display: block; }
        button {
            width: 100%;
            margin-top: 24px;
            padding: 13px;
            border: none;
            border-radius: 6px;
            background: #2563eb;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }
        .google-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            margin-top: 12px;
            padding: 13px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            background: white;
            color: #172033;
            font-size: 16px;
            text-decoration: none;
            font-weight: 600;
            transition: background-color 0.15s ease, border-color 0.15s ease;
        }
        .google-button:hover {
            background: #f8fafc;
            border-color: #94a3b8;
        }
        .google-icon {
            width: 20px;
            height: 20px;
            flex: 0 0 20px;
        }
        .notice {
            padding: 10px;
            border-radius: 6px;
            background: #eff6ff;
            color: #1e40af;
        }
        .error-notice {
            padding: 10px;
            border: 1px solid #fecaca;
            border-radius: 6px;
            background: #fef2f2;
            color: #991b1b;
            line-height: 1.5;
        }
        p { text-align: center; }
        a { color: #2563eb; }
    </style>
</head>
<body>
    <div class="container">
        <a class="brand-link" href="/" aria-label="The Marketplace home">
            <img class="brand-logo" src="/images/multivendor-logo.png" alt="Multi Vendor Marketplace logo">
        </a>
        <h1>Welcome Back</h1>
        <p>Log in to your marketplace account.</p>
        <% if (typeof csrfExpired !== "undefined" && csrfExpired) { %>
            <p class="error-notice" role="alert">Your login page expired, so your sign-in was not submitted. Please enter your email and password again.</p>
        <% } %>
        <% if (typeof loginError !== "undefined" && loginError === "required") { %>
            <p class="error-notice" role="alert">Enter your email address and password to sign in.</p>
        <% } else if (typeof loginError !== "undefined" && loginError === "invalid") { %>
            <p class="error-notice" role="alert">The email or password you entered is incorrect. Check your details and try again.</p>
        <% } else if (typeof loginError !== "undefined" && loginError === "verification-unavailable") { %>
            <p class="error-notice" role="alert">Your account needs email verification, but the verification email could not be sent. Please try again later or contact the site administrator.</p>
        <% } else if (typeof loginError !== "undefined" && loginError === "unavailable") { %>
            <p class="error-notice" role="alert">We could not sign you in right now. Please try again shortly.</p>
        <% } %>
        <% if (typeof passwordReset !== "undefined" && passwordReset) { %>
            <p class="notice" role="status">Your password was changed. You can now sign in.</p>
        <% } %>
        <% if (typeof registrationComplete !== "undefined" && registrationComplete) { %>
            <p class="notice" role="status">Your account is ready. You can now sign in.</p>
        <% } %>
        <% if (typeof verify !== "undefined" && verify === "sent") { %>
            <p class="notice" role="status">If your account needs verification, a verification link has been sent to your email address. Check your inbox and spam folder.</p>
        <% } else if (typeof verify !== "undefined" && verify === "local") { %>
            <p class="notice" role="status">
                Email delivery is not configured. In this local development app, logging in with the correct password automatically verifies your account.
            </p>
        <% } else if (typeof verify !== "undefined" && verify === "success") { %>
            <p class="notice" role="status">Your email is verified. You can now sign in.</p>
        <% } else if (typeof verify !== "undefined" && verify === "invalid") { %>
            <p class="notice" role="status">That verification link is invalid or expired. Request a new one below.</p>
        <% } %>

        <form action="/auth/login" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <label for="email">Email address</label>
            <input
                id="email"
                name="email"
                type="email"
                maxlength="150"
                autocomplete="email"
                required
            >

            <label for="password">Password</label>
            <div class="password-field">
                <input id="password" name="password" type="password" autocomplete="current-password" required>
                <button class="password-toggle" type="button" aria-label="Show password" aria-controls="password" aria-pressed="false">
                    <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m3 3 18 18"></path>
                        <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
                        <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.8 15.8 0 0 1-3.1 3.9"></path>
                        <path d="M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10.8 10.8 0 0 0 4-.8"></path>
                    </svg>
                </button>
            </div>
            <p><a href="/forgot-password">Forgot password?</a></p>

            <button type="submit">Log In</button>
        </form>

        <% if (typeof googleConfigured !== "undefined" && googleConfigured) { %>
            <a class="google-button" href="/auth/google">
                <svg class="google-icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5Z" transform="translate(0 4)"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.72 7.18l7.62 5.91c4.45-4.11 7.14-10.16 7.14-17.56Z"/>
                    <path fill="#FBBC05" d="M10.53 28.59a14.4 14.4 0 0 1 0-9.18l-7.98-6.19a23.9 23.9 0 0 0 0 21.56l7.98-6.19Z" transform="translate(0 4)"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.9-5.8l-7.62-5.91c-2.12 1.42-4.84 2.26-8.28 2.26-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48Z" transform="translate(0 -4)"/>
                </svg>
                <span>Continue with Google</span>
            </a>
        <% } else { %>
            <p class="notice">Google sign-in needs OAuth credentials configured by the site administrator.</p>
        <% } %>
        <p>Don't have an account? <a href="/register">Register here</a></p>
        <p><a href="/">Back to marketplace</a></p>
    </div>
    <script nonce="<%= cspNonce %>">
        const passwordInput = document.querySelector("#password");
        const passwordToggle = document.querySelector(".password-toggle");

        if (passwordInput && passwordToggle) {
            passwordToggle.addEventListener("click", () => {
                const isVisible = passwordInput.type === "text";
                passwordInput.type = isVisible ? "password" : "text";
                passwordToggle.setAttribute("aria-pressed", String(!isVisible));
                passwordToggle.setAttribute("aria-label", isVisible ? "Show password" : "Hide password");
            });
        }
    </script>
</body>
</html>
