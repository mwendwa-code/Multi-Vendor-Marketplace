<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administrator verification | The Marketplace</title>
    <style>
        body { margin: 0; min-height: 100vh; padding: 24px; display: grid; place-items: center; font: 16px Arial, sans-serif; color: #172033; background: #f1f5f9; }
        main { width: min(100%, 480px); padding: 28px; background: white; border-radius: 12px; box-shadow: 0 12px 36px #0f172a1a; }
        h1 { color: #102a43; }
        label { display: block; margin-top: 20px; font-weight: 700; }
        input { width: 100%; box-sizing: border-box; margin-top: 8px; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 18px; }
        button { width: 100%; margin-top: 18px; padding: 13px; border: 0; border-radius: 6px; color: white; background: #2563eb; font-size: 16px; cursor: pointer; }
        .error { padding: 12px; color: #991b1b; background: #fef2f2; border-radius: 6px; }
        :focus-visible { outline: 3px solid #f59e0b; outline-offset: 2px; }
    </style>
</head>
<body>
    <main>
        <h1>Verify your administrator sign-in</h1>
        <p>Enter a current code from your authenticator app, or use one unused recovery code.</p>
        <p><strong>Account:</strong> <%= user.email %></p>
        <% if (errorMessage) { %><p class="error" role="alert"><%= errorMessage %></p><% } %>
        <form action="/auth/two-factor/verify" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="code">Authenticator or recovery code</label>
            <input id="code" name="code" type="text" inputmode="text" maxlength="11" autocomplete="one-time-code" required autofocus>
            <button type="submit">Verify and continue</button>
        </form>
    </main>
</body>
</html>
