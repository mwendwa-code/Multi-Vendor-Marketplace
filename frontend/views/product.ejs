<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> | The Marketplace</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            color: #172033;
        }
        header {
            background: #172554;
            color: white;
            padding: 20px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }
        .brand-link {
            display: inline-flex;
            align-items: center;
            text-decoration: none;
        }
        .brand-logo {
            display: block;
            max-height: 72px;
            width: auto;
            object-fit: contain;
            filter: drop-shadow(0 10px 16px rgba(14, 116, 144, 0.2));
        }
        nav a {
            color: white;
            text-decoration: none;
            margin-left: 16px;
        }
        .cart-link {
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .cart-icon {
            width: 24px;
            height: 24px;
            fill: none;
            stroke: currentColor;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-width: 1.8;
        }
        .cart-badge {
            background: #f59e0b;
            color: #111827;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            min-width: 20px;
            height: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 6px;
        }
        main {
            max-width: 980px;
            margin: 40px auto;
            padding: 0 16px 40px;
        }
        .product-layout {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 30px;
            background: white;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
        }
        .product-image {
            width: 100%;
            height: 420px;
            object-fit: cover;
            border-radius: 10px;
            background: #e2e8f0;
        }
        .price {
            color: #2563eb;
            font-weight: bold;
            font-size: 32px;
            margin: 12px 0;
        }
        .meta {
            color: #475569;
            margin-bottom: 18px;
        }
        .actions {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 22px;
            flex-wrap: wrap;
        }
        input, button {
            font: inherit;
        }
        input[type="number"] {
            width: 90px;
            padding: 10px 12px;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
        }
        button {
            padding: 10px 18px;
            border: 0;
            border-radius: 6px;
            background: #2563eb;
            color: white;
            cursor: pointer;
        }
        .secondary {
            background: #e2e8f0;
            color: #0f172a;
            text-decoration: none;
            display: inline-block;
            padding: 10px 18px;
            border-radius: 6px;
        }
        .seller-logo {
            width: 56px;
            height: 56px;
            margin-right: 10px;
            vertical-align: middle;
            border-radius: 50%;
            object-fit: cover;
        }
        .wishlist-button {
            background: #e2e8f0;
            color: #0f172a;
        }
        .toast {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 10;
            max-width: min(420px, calc(100vw - 40px));
            padding: 14px 18px;
            border: 1px solid #bbf7d0;
            border-radius: 12px;
            background: #14532d;
            color: white;
            box-shadow: 0 12px 30px rgba(15,23,42,0.24);
            opacity: 0;
            transform: translateY(12px);
            pointer-events: none;
            transition: opacity 180ms ease, transform 180ms ease;
        }
        .toast.is-visible { opacity: 1; transform: translateY(0); }
        .cart-badge.is-bumped { animation: badge-bump 320ms ease; }
        @keyframes badge-bump { 50% { transform: scale(1.3); } }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
        }
    </style>
</head>
<body>
    <header>
        <a class="brand-link" href="/" aria-label="The Marketplace home">
            <img class="brand-logo" src="/images/multivendor-logo.png" alt="Multi Vendor Marketplace logo">
        </a>
        <nav>
            <a href="/">Home</a>
            <% if (!user || user.role !== "seller") { %>
                <a href="/cart" class="cart-link" aria-label="Shopping cart, <%= cartCount %> items" title="Shopping cart">
                    <svg class="cart-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M3 3h2l2.4 12.2a2 2 0 0 0 2-1.6h8.8a2 2 0 0 0 2-1.6L22 8H6"></path>
                        <circle cx="10" cy="20" r="1"></circle>
                        <circle cx="18" cy="20" r="1"></circle>
                    </svg>
                    <% if (cartCount > 0) { %>
                        <span class="cart-badge"><%= cartCount %></span>
                    <% } %>
                </a>
            <% } %>
            <% if (user) { %>
                <span>Hi, <%= user.name %></span>
                <form action="/auth/logout" method="POST" style="display:inline; margin-left:16px;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit">Logout</button>
                </form>
            <% } else { %>
                <a href="/login">Login</a>
                <a href="/register">Register</a>
            <% } %>
        </nav>
    </header>

    <main>
        <div class="product-layout">
            <div>
                <img class="product-image" src="<%= productImage(product) %>" alt="<%= product.name %>">
            </div>
            <div>
                <p class="meta">Category: <%= product.category_name || "Other" %></p>
                <h2><%= product.name %></h2>
                <div class="price">
                    <% if (Number(product.current_promotion_discount_percent) > 0) { %>
                        <span style="color:#64748b;font-size:18px;text-decoration:line-through;">KSh <%= Number(product.price).toLocaleString("en-KE") %></span>
                        KSh <%= Number(product.current_price).toLocaleString("en-KE") %>
                        <span style="display:inline-block;padding:3px 7px;border-radius:999px;background:#dbeafe;color:#1d4ed8;font-size:13px;"><%= Number(product.current_promotion_discount_percent) %>% off</span>
                    <% } else { %>
                        KSh <%= Number(product.price).toLocaleString("en-KE") %>
                    <% } %>
                </div>
                <p><%= product.description || "No description available." %></p>
                <% if (product.business_name) { %>
                    <% if (product.business_logo) { %>
                        <img class="seller-logo" src="<%= product.business_logo %>" alt="<%= product.business_name %> logo">
                    <% } %>
                    <p class="meta">Sold by <%= product.business_name %></p>
                <% } %>
                <% if (product.business_description) { %>
                    <p class="meta"><%= product.business_description %></p>
                <% } %>
                <% if (product.business_website) { %>
                    <p><a href="<%= product.business_website %>" target="_blank" rel="noopener noreferrer">Visit business website</a></p>
                <% } %>
                <p class="meta">In stock: <%= product.stock %></p>

                <% if (!user || user.role !== "seller") { %>
                    <form action="/cart/add" method="POST" data-add-to-cart>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="productId" value="<%= product.id %>">
                        <div class="actions">
                            <label for="quantity">Qty</label>
                            <input id="quantity" name="quantity" type="number" min="1" max="<%= product.stock %>" value="1">
                            <button type="submit" <%= product.stock <= 0 ? 'disabled' : '' %>><%= product.stock <= 0 ? "Out of stock" : "Add to cart" %></button>
                            <a class="secondary" href="/">Continue shopping</a>
                        </div>
                    </form>
                <% } else { %>
                    <p class="meta">Seller preview — purchase controls are disabled.</p>
                    <p><a class="secondary" href="/seller">Back to seller dashboard</a></p>
                <% } %>
                <% if (user && (user.role === "customer" || user.role === "buyer")) { %>
                    <form action="/customer/wishlist/<%= product.id %>" method="POST" class="actions">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="wishlist-button" type="submit">Save to wishlist</button>
                    </form>
                <% } %>
            </div>
        </div>
        <section class="product-reviews" aria-labelledby="product-reviews-title" style="margin-top:24px;padding:24px;background:white;border-radius:12px;box-shadow:0 4px 16px rgba(15,23,42,.08);">
            <h2 id="product-reviews-title">Customer reviews</h2>
            <% if (productReviews && productReviews.length) { %>
                <% productReviews.forEach(function(review) { %>
                    <article style="padding:14px 0;border-bottom:1px solid #e2e8f0;">
                        <strong><%= review.customer_name %></strong>
                        <span style="color:#b45309;" aria-label="<%= review.rating %> out of 5 stars"><%= "★".repeat(Number(review.rating)) %><%= "☆".repeat(5 - Number(review.rating)) %></span>
                        <p><%= review.comment || "No written comment." %></p>
                        <% if (review.seller_response) { %><p style="padding:10px 12px;border-left:3px solid #2563eb;background:#eff6ff;"><strong>Seller response:</strong> <%= review.seller_response %></p><% } %>
                    </article>
                <% }); %>
            <% } else { %>
                <p>No customer reviews yet.</p>
            <% } %>
        </section>
    </main>
    <div class="toast" id="marketplace-toast" role="status" aria-live="polite" aria-atomic="true"></div>
    <script src="/js/main.js" defer></script>
</body>
</html>
