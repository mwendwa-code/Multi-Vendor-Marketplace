<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | The Marketplace</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 30px 16px;
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            color: #172033;
        }
        main {
            max-width: 480px;
            margin: 40px auto;
            padding: 28px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 16px #00000012;
        }
        h1 { text-align: center; color: #172554; }
        label { display: block; margin-top: 18px; font-weight: 600; }
        input {
            width: 100%;
            padding: 12px;
            margin-top: 7px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font: inherit;
        }
        .password-field { display: flex; gap: 8px; align-items: stretch; }
        .password-field input { flex: 1; min-width: 0; }
        .password-toggle {
            width: auto;
            margin-top: 7px;
            padding: 0 11px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            background: white;
            color: #172033;
            display: inline-grid;
            place-items: center;
        }
        .password-toggle svg { width: 20px; height: 20px; }
        .password-toggle .eye-closed { display: none; }
        .password-toggle[aria-pressed="true"] .eye-open { display: none; }
        .password-toggle[aria-pressed="true"] .eye-closed { display: block; }
        button {
            width: 100%;
            margin-top: 18px;
            padding: 12px;
            border: 0;
            border-radius: 6px;
            background: #2563eb;
            color: white;
            font: inherit;
            cursor: pointer;
        }
        .message {
            padding: 12px;
            border-radius: 6px;
            background: #eff6ff;
            color: #1e40af;
        }
        p { line-height: 1.5; }
        a { color: #2563eb; }
    </style>
</head>
<body>
    <main>
        <h1>Forgot password?</h1>
        <p>Enter your account email and we’ll send a six-digit reset code if an account exists.</p>

        <% if (message) { %>
            <p class="message" role="status"><%= message %></p>
        <% } %>

        <form action="/auth/forgot-password" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="request-email">Email address</label>
            <input id="request-email" name="email" type="email" maxlength="150" autocomplete="email"
                   value="<%= email || '' %>" required>
            <button type="submit">Send reset code</button>
        </form>

        <section>
            <h2>Need to verify your email?</h2>
            <p>If you can’t sign in because your email isn’t verified, request a new verification link.</p>
            <form action="/auth/resend-verification" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label for="verification-email">Email address</label>
                <input id="verification-email" name="email" type="email" maxlength="150"
                       autocomplete="email" value="<%= email || '' %>" required>
                <button type="submit">Resend verification link</button>
            </form>
        </section>

        <hr>

        <form action="/auth/reset-password" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="reset-email">Email address</label>
            <input id="reset-email" name="email" type="email" maxlength="150" autocomplete="email"
                   value="<%= email || '' %>" required>

            <label for="code">Six-digit code</label>
            <input id="code" name="code" type="text" inputmode="numeric"
                   pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required>

            <label for="new-password">New password</label>
            <div class="password-field">
                <input id="new-password" name="password" type="password" minlength="8"
                       autocomplete="new-password" required>
                <button class="password-toggle" type="button" aria-label="Show password"
                        aria-controls="new-password" aria-pressed="false">
                    <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m3 3 18 18"></path>
                        <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
                        <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.8 15.8 0 0 1-3.1 3.9"></path>
                        <path d="M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10.8 10.8 0 0 0 4-.8"></path>
                    </svg>
                </button>
            </div>
            <button type="submit">Reset password</button>
        </form>

        <p><a href="/login">Back to login</a></p>
    </main>
    <script nonce="<%= cspNonce %>">
        const passwordInput = document.querySelector("#new-password");
        const passwordToggle = document.querySelector(".password-toggle");
        passwordToggle.addEventListener("click", () => {
            const isVisible = passwordInput.type === "text";
            passwordInput.type = isVisible ? "password" : "text";
            passwordToggle.setAttribute("aria-pressed", String(!isVisible));
            passwordToggle.setAttribute("aria-label", isVisible ? "Show password" : "Hide password");
        });
    </script>
</body>
</html>
