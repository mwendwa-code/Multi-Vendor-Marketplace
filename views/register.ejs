
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account | The Marketplace</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            margin: 0;
            padding: 40px 16px;
        }
        .container {
            max-width: 420px;
            margin: 30px auto;
            padding: 28px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 16px #0001;
        }
        h1 { text-align: center; color: #172554; }
        label { display: block; margin-top: 16px; }
        input, select {
            box-sizing: border-box;
            width: 100%;
            padding: 12px;
            margin-top: 6px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
        }
        .password-field { display: flex; gap: 8px; align-items: stretch; }
        .password-field input { flex: 1; min-width: 0; }
        .password-toggle {
            width: auto;
            margin-top: 6px;
            padding: 0 11px;
            border: 1px solid #cbd5e1;
            background: white;
            color: #172033;
            display: inline-grid;
            place-items: center;
        }
        .password-toggle svg { width: 20px; height: 20px; }
        .password-toggle .eye-closed { display: none; }
        .password-toggle[aria-pressed="true"] .eye-open { display: none; }
        .password-toggle[aria-pressed="true"] .eye-closed { display: block; }
        button {
            width: 100%;
            padding: 12px;
            margin-top: 22px;
            background: #2563eb;
            color: white;
            border: 0;
            border-radius: 6px;
            cursor: pointer;
        }
        .google-button {
            display: block;
            width: 100%;
            margin-top: 12px;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            background: white;
            color: #172033;
            text-align: center;
            text-decoration: none;
            font-weight: 600;
        }
        .notice {
            padding: 10px;
            border-radius: 6px;
            background: #eff6ff;
            color: #1e40af;
            line-height: 1.5;
        }
        p { text-align: center; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Create Account</h1>
        <% if (checkoutRequired) { %>
            <p class="notice" role="status">Create an account before placing your order. Your cart will be saved; after registering, log in to continue. Already have an account? <a href="/login">Log in</a>.</p>
        <% } %>

        <form action="/auth/register" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (referralCode) { %>
                <input type="hidden" name="referralCode" value="<%= referralCode %>">
                <p class="notice" role="status">You’re joining through a customer referral.</p>
            <% } %>
            <label for="name">Full name</label>
            <input id="name" name="name" type="text" maxlength="100" required>

            <label for="email">Email</label>
            <input id="email" name="email" type="email" maxlength="150" required>

            <label for="password">Password</label>
            <div class="password-field">
                <input id="password" name="password" type="password"
                       minlength="8" maxlength="72" autocomplete="new-password" required>
                <button class="password-toggle" type="button" aria-label="Show password" aria-controls="password" aria-pressed="false">
                    <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m3 3 18 18"></path>
                        <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
                        <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.8 15.8 0 0 1-3.1 3.9"></path>
                        <path d="M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10.8 10.8 0 0 0 4-.8"></path>
                    </svg>
                </button>
            </div>

            <label for="role">Account type</label>
            <select id="role" name="role" required>
                <option value="customer">Customer</option>
                <option value="seller">Seller</option>
            </select>

            <div id="business-name-field" hidden>
                <label for="businessName">Business name</label>
                <input id="businessName" name="businessName" type="text" maxlength="150">
                <label for="businessWebsite">Business website (optional)</label>
                <input id="businessWebsite" name="businessWebsite" type="url" maxlength="2048" placeholder="https://example.com" autocomplete="url" disabled>
            </div>

            <button type="submit">Register</button>
        </form>

        <% if (typeof googleConfigured !== "undefined" && googleConfigured) { %>
            <a class="google-button" href="<%= referralCode ? `/auth/google?ref=${encodeURIComponent(referralCode)}` : '/auth/google' %>">Continue with Google</a>
        <% } else { %>
            <p class="notice">Google sign-up needs OAuth credentials configured by the site administrator.</p>
        <% } %>
        <p>Already registered? <a href="/login">Log in</a></p>
        <p><a href="/">Back to marketplace</a></p>
    </div>
    <script src="/js/main.js" defer></script>
    <script nonce="<%= cspNonce %>">
        const passwordInput = document.querySelector("#password");
        const passwordToggle = document.querySelector(".password-toggle");

        if (passwordInput && passwordToggle) {
            passwordToggle.addEventListener("click", () => {
                const isVisible = passwordInput.type === "text";
                passwordInput.type = isVisible ? "password" : "text";
                passwordToggle.setAttribute("aria-pressed", String(!isVisible));
                passwordToggle.setAttribute("aria-label", isVisible ? "Show password" : "Hide password");
            });
        }
    </script>
</body>
</html>